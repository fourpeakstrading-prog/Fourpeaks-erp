# Copy this file to .env and change the secrets before running in production.

# PostgreSQL
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=erp

# Backend
DATABASE_URL=postgresql+psycopg://erp:erp@db:5432/erp
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=480

# First owner account, created on first start if no users exist
FIRST_OWNER_EMAIL=owner@example.com
FIRST_OWNER_PASSWORD=change-me
FIRST_OWNER_NAME=Owner

# Frontend
VITE_API_URL=http://localhost:8000
